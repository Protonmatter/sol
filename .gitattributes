# One line-ending story on every platform. The generated JSON artifacts embed
# newline-normalized byte counts and the CI determinism gate diffs regenerated files
# against the committed ones — CRLF-smudged checkouts (Windows autocrlf) broke both.
* text=auto
*.rs text eol=lf
*.js text eol=lf
*.py text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ps1 text eol=lf
# The committed Horizons CSVs are hashed in tools/ephemeris-data/moons/README.md, and a
# CRLF-smudged checkout cannot reproduce those sha256s.
*.csv text eol=lf

*.wasm binary
*.png binary
*.jpg binary
*.ppm binary
*.bin binary
*.f32 binary
*.txt text eol=lf
**/COPYING.LESSER.LGPL-3.0 text eol=lf
**/COPYING.GPL-3.0 text eol=lf
**/upstream/LICENSE text eol=lf
# Preferred ephemeris inputs are bound to original upstream bytes and Git blobs.
/crates/solar-ephemeris/rebuild/upstream/*.js -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Immutable research bundles bind raw payload bytes, including line endings.
# Do not normalize their JSON during staging or checkout: that invalidates hashes.
# Recognize preserved CRLF while retaining the standard whitespace-error checks.
/apps/web/data/bundles/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/tests/fixtures/feed-source/bundles/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/tests/fixtures/canonical-moon-20261103/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/tests/fixtures/horizons-vectors-20261104/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/tests/fixtures/horizons-apparent-20261104/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/tests/fixtures/horizons-precision-1900-2200-20261104/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/tests/fixtures/iers-eop-20261104/** -text whitespace=-blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
/tests/fixtures/horizons-events-20261104/** -text whitespace=-blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
/tests/fixtures/canonical-moon-20261104/** -text whitespace=-blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
