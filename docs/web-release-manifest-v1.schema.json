{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "web-release-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "source_sha",
    "repository",
    "run_id",
    "run_attempt",
    "base_path",
    "namespace",
    "schemas",
    "abi_versions",
    "data_bundle_id",
    "wasm_sha256",
    "components",
    "previous_release_id",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": "web-release-manifest.v1"
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "description": "Exact character and semantic constraints are enforced by the release validator."
    },
    "source_sha": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "description": "Exact character and semantic constraints are enforced by the release validator."
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "description": "Exact character and semantic constraints are enforced by the release validator."
    },
    "run_id": {
      "type": "integer",
      "minimum": 1
    },
    "run_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "base_path": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "abi_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solar",
        "ephemeris"
      ],
      "properties": {
        "solar": {
          "const": 1
        },
        "ephemeris": {
          "const": 1
        }
      }
    },
    "data_bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "wasm_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solar_wasm.wasm",
        "solar_ephemeris.wasm"
      ],
      "properties": {
        "solar_wasm.wasm": {
          "$ref": "#/$defs/sha256"
        },
        "solar_ephemeris.wasm": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ui",
        "science"
      ],
      "properties": {
        "ui": {
          "$ref": "#/$defs/sha256"
        },
        "science": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "previous_release_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "data_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "manifest_path",
        "manifest_sha256"
      ],
      "properties": {
        "bundle_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "description": "Exact character and semantic constraints are enforced by the release validator."
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size",
        "sha256",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "role": {
          "enum": [
            "critical",
            "optional"
          ]
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
