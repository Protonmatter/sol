{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "manifest_path",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "bundle-pointer.v1"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_path": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
