{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "release-profiles.v1 protected policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_accepted",
    "settings_verified",
    "approved_candidates",
    "accepted_evidence",
    "supported_schemas",
    "required_job_names"
  ],
  "properties": {
    "accepted_served_evidence": {"type": "array", "items": {"type": "string", "minLength": 64, "maxLength": 64}},
    "required_job_names": {
      "description": "Exact expanded mandatory job map from the pinned reviewed verifier, including matrix members and reusable-workflow children.",
      "type": "object",
      "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    },
    "schema_version": {
      "const": "release-profiles.v1"
    },
    "policy_accepted": {
      "type": "boolean"
    },
    "settings_verified": {
      "type": "boolean"
    },
    "approved_candidates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile",
          "required_cases",
          "required_kinds",
          "manifest_sha256",
          "components",
          "platforms",
          "schemas"
        ],
        "properties": {
          "rollback_authorization": {"type": "object", "additionalProperties": false,
            "required": ["source_sha", "artifact_id", "manifest_sha256", "origin", "corrected", "expires_on", "reviewed_by", "acceptance_id"],
            "properties": {
              "source_sha": {"type": "string", "minLength": 40, "maxLength": 40}, "artifact_id": {"type": "integer", "minimum": 1},
              "manifest_sha256": {"type": "string", "minLength": 64, "maxLength": 64}, "origin": {"type": "string", "minLength": 1},
              "corrected": {"type": "boolean"}, "expires_on": {"type": "string"},
              "reviewed_by": {"type": "string", "minLength": 1}, "acceptance_id": {"type": "string", "minLength": 1}
            }},
          "change_review": {
            "type": "object", "additionalProperties": false, "required": ["base_sha", "diff_sha256"],
            "properties": {
              "base_sha": {"type": "string", "minLength": 40, "maxLength": 40},
              "diff_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
              "unknown_review": {"type": "object", "additionalProperties": false,
                "required": ["paths", "reviewed_by", "acceptance_id"], "properties": {
                  "paths": {"type": "array", "items": {"type": "string"}},
                  "reviewed_by": {"type": "string", "minLength": 1}, "acceptance_id": {"type": "string", "minLength": 1}
                }}
            }
          },
          "qualification_scope": {"type": "object", "additionalProperties": {
            "type": "object", "additionalProperties": {"type": "object", "additionalProperties": false,
              "required": ["components", "platforms"], "properties": {
                "components": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "platforms": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "quantities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "epoch_start_jd": {"type": "number"}, "epoch_end_jd": {"type": "number"}
              }}}},
          "profile": {
            "enum": [
              "corrective",
              "experience-milestone"
            ]
          },
          "required_cases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "required_kinds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "manual",
                "scientific"
              ]
            }
          },
          "manifest_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "description": "Exact character and semantic constraints are enforced by the release validator."
          },
          "components": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "description": "Exact character and semantic constraints are enforced by the release validator."
            }
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "schemas": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "accepted_evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewed_by",
          "acceptance_id"
        ],
        "properties": {
          "reviewed_by": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "supported_schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "served_manifest_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "description": "Exact character and semantic constraints are enforced by the release validator."
    }
  }
}
