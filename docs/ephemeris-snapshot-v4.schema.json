{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Protonmatter/sol/docs/ephemeris-snapshot-v4.schema.json",
  "title": "ephemeris-snapshot.v4",
  "description": "Provider-neutral apparent-place contract shared by the on-device WASM and optional JPL DE441 server tiers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engine_version",
    "time",
    "observer",
    "accuracy",
    "bodies",
    "warnings",
    "events_window"
  ],
  "properties": {
    "schema_version": {
      "const": "ephemeris-snapshot.v4"
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "$ref": "#/$defs/provider"
    },
    "time": {
      "$ref": "#/$defs/time"
    },
    "observer": {
      "$ref": "#/$defs/observer"
    },
    "accuracy": {
      "$ref": "#/$defs/accuracy"
    },
    "bodies": {
      "type": "array",
      "minItems": 9,
      "items": {
        "$ref": "#/$defs/body"
      }
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "events_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "convention",
        "time_scale",
        "interval",
        "start_jd",
        "end_jd"
      ],
      "properties": {
        "convention": {
          "const": "observer_local_mean_solar_day"
        },
        "time_scale": {
          "const": "UTC",
          "description": "Legacy name for the requested calendar axis. Instantaneous semantics are in time.input_time_semantics; future_nominal_utc_after_jd separately discloses modeled future support in a mixed event window."
        },
        "interval": {
          "const": "[start,end)"
        },
        "start_jd": {
          "type": "number"
        },
        "end_jd": {
          "type": "number"
        },
        "future_nominal_utc_after_jd": {
          "type": "number",
          "description": "Optional EOP endpoint: event calculations after it use modeled UT1 and nominal UTC with the last tabulated leap offset assumed, unknown model uncertainty and omitted polar motion. May be inside the solver support interval extending ten minutes after end_jd; instantaneous time semantics remain separate."
        }
      }
    },
    "star_frame": {
      "$ref": "#/$defs/starFrame"
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "source",
        "ephemeris",
        "endpoint_contract"
      ],
      "properties": {
        "tier": {
          "enum": [
            "client",
            "server"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "ephemeris": {
          "type": "string",
          "minLength": 1
        },
        "endpoint_contract": {
          "const": "ephemeris-snapshot.v4"
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jd_utc",
        "jd_tai",
        "jd_tt",
        "jd_ut1",
        "tai_minus_utc_seconds",
        "dut1_seconds",
        "delta_t_seconds",
        "lst_deg",
        "obliquity_deg",
        "earth_orientation",
        "calendar",
        "input_time_semantics"
      ],
      "properties": {
        "jd_utc": {
          "type": "number"
        },
        "jd_tai": {
          "type": [
            "number",
            "null"
          ]
        },
        "jd_tt": {
          "type": "number"
        },
        "jd_ut1": {
          "type": "number"
        },
        "tai_minus_utc_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "dut1_seconds": {
          "type": "number",
          "description": "UT1 minus the input calendar axis in seconds; real UTC retains the 0.9 s steering bound, future_nominal_utc is a modeled offset without that bound."
        },
        "delta_t_seconds": {
          "type": "number"
        },
        "lst_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "obliquity_deg": {
          "type": "number",
          "minimum": 20,
          "maximum": 26
        },
        "earth_orientation": {
          "$ref": "#/$defs/earthOrientation"
        },
        "calendar": {
          "const": "proleptic_gregorian"
        },
        "input_time_semantics": {
          "enum": [
            "utc",
            "historical_ut1_proxy",
            "future_nominal_utc"
          ]
        }
      }
    },
    "earthOrientation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "quality",
        "xp_arcsec",
        "yp_arcsec",
        "dut1_uncertainty_seconds"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "quality": {
          "enum": [
            "rapid",
            "predicted",
            "degraded",
            "pre_utc_ut1_proxy",
            "modeled_future"
          ]
        },
        "xp_arcsec": {
          "type": "number"
        },
        "yp_arcsec": {
          "type": "number"
        },
        "dut1_uncertainty_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Null only for modeled_future, whose uncertainty is not qualified; otherwise a nonnegative EOP formal error or degraded allowance."
        }
      }
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terrestrial_lat_deg",
        "terrestrial_lon_deg_east",
        "polar_motion_corrected_lat_deg",
        "polar_motion_corrected_lon_deg_east",
        "elev_m"
      ],
      "properties": {
        "terrestrial_lat_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "terrestrial_lon_deg_east": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "polar_motion_corrected_lat_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "polar_motion_corrected_lon_deg_east": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "elev_m": {
          "type": "number",
          "minimum": -12000,
          "maximum": 100000
        }
      }
    },
    "accuracy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "coordinate_semantics",
        "time_scales",
        "eop_status",
        "validation_scope",
        "valid_epoch",
        "non_goal",
        "evidence_status",
        "evidence_record_ids"
      ],
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_semantics": {
          "type": "string",
          "minLength": 1
        },
        "time_scales": {
          "type": "string",
          "minLength": 1
        },
        "eop_status": {
          "enum": [
            "rapid",
            "predicted",
            "degraded",
            "pre_utc_ut1_proxy",
            "modeled_future"
          ]
        },
        "validation_scope": {
          "type": "string",
          "minLength": 1
        },
        "valid_epoch": {
          "type": "string",
          "minLength": 1
        },
        "non_goal": {
          "type": "string",
          "minLength": 1
        },
        "evidence_status": {
          "enum": [
            "unvalidated",
            "validated_at_recorded_samples"
          ]
        },
        "evidence_record_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "coordinate_frame",
        "ra_deg",
        "dec_deg",
        "geocentric_apparent_ra_deg",
        "geocentric_apparent_dec_deg",
        "topocentric_apparent_ra_deg",
        "topocentric_apparent_dec_deg",
        "alt_deg",
        "az_deg",
        "alt_refracted_deg",
        "above_horizon",
        "compass",
        "angular_size_arcsec",
        "horizontal_parallax_deg",
        "geocentric_range_km",
        "observer_range_km",
        "range_approximation",
        "events"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "star",
            "moon",
            "planet"
          ]
        },
        "coordinate_frame": {
          "const": "true_equator_and_equinox_of_date"
        },
        "ra_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "dec_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "geocentric_apparent_ra_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "geocentric_apparent_dec_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "topocentric_apparent_ra_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "topocentric_apparent_dec_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "alt_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "az_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "alt_refracted_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 91
        },
        "above_horizon": {
          "type": "boolean"
        },
        "compass": {
          "type": "string",
          "minLength": 1
        },
        "angular_size_arcsec": {
          "type": "number",
          "minimum": 0
        },
        "horizontal_parallax_deg": {
          "type": "number",
          "minimum": 0
        },
        "magnitude": {
          "type": "number"
        },
        "geocentric_range_km": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "observer_range_km": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "range_approximation": {
          "enum": [
            "finite",
            "infinite_catalogue_star"
          ]
        },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rise",
            "transit",
            "set"
          ],
          "properties": {
            "rise": {
              "$ref": "#/$defs/event"
            },
            "transit": {
              "$ref": "#/$defs/transit"
            },
            "set": {
              "$ref": "#/$defs/event"
            }
          }
        },
        "catalogue_ra_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "catalogue_dec_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jd",
        "calculation_status",
        "occurrence_status",
        "source"
      ],
      "properties": {
        "jd": {
          "type": [
            "number",
            "null"
          ]
        },
        "calculation_status": {
          "enum": [
            "calculated",
            "not_calculated",
            "failed"
          ]
        },
        "occurrence_status": {
          "enum": [
            "occurs",
            "none_in_window",
            "unknown"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine",
            "version"
          ],
          "properties": {
            "engine": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "transit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jd",
        "calculation_status",
        "occurrence_status",
        "source",
        "altitude_deg"
      ],
      "properties": {
        "jd": {
          "type": [
            "number",
            "null"
          ]
        },
        "calculation_status": {
          "enum": [
            "calculated",
            "not_calculated",
            "failed"
          ]
        },
        "occurrence_status": {
          "enum": [
            "occurs",
            "none_in_window",
            "unknown"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine",
            "version"
          ],
          "properties": {
            "engine": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "altitude_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        }
      }
    },
    "starFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "source",
        "jd_utc",
        "lst_deg",
        "observer",
        "j2000_to_true_equatorial"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "jd_utc": {
          "type": "number"
        },
        "lst_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "observer": {
          "$ref": "#/$defs/observer"
        },
        "j2000_to_true_equatorial": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
