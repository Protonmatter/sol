{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded ephemeris accuracy evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "records",
    "unvalidated_quantities",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "accuracy-evidence.v1"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "body",
          "quantity",
          "tested_epochs_jd",
          "time_scale",
          "method",
          "observer_domain",
          "reference",
          "measured_error",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "string",
            "minLength": 1
          },
          "tested_epochs_jd": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number"
            }
          },
          "time_scale": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "source_theory_parity",
              "independent_reference"
            ]
          },
          "observer_domain": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "git_revision",
              "path",
              "sha256_lf",
              "symbol",
              "vector_au"
            ],
            "properties": {
              "git_revision": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256_lf": {
                "type": "string",
                "minLength": 1
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "vector_au": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "measured_error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "value",
              "acceptance_threshold"
            ],
            "properties": {
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "number",
                "minimum": 0
              },
              "acceptance_threshold": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unvalidated_quantities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    }
  }
}
